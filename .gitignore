# ──────────────────────────────────────────────
# CMS — Client Management System
# .gitignore
# ──────────────────────────────────────────────

# ── Secrets (NEVER commit these) ────────────────
.env

# ── Maven build output ──────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── IDE files ───────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
.vscode/
.classpath
.project
.settings/
*.eclipse

# ── OS files ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Environment & secrets ───────────────────────
.env
.env.*
!.env.example
*.secret

# ── Spring Boot ─────────────────────────────────
HELP.md
spring-shell.log

# ── Docker volumes (if mounted locally) ─────────
docker/volumes/

# ── Logs ────────────────────────────────────────
*.log
logs/

# ── Test reports ────────────────────────────────
**/surefire-reports/
**/failsafe-reports/

# ── SonarQube ───────────────────────────────────
.sonar/
sonar-project.properties

# ── Gradle (if switching later) ──────────────────
.gradle/
build/

# ── Node (if a frontend is added later) ──────────
node_modules/
npm-debug.log*
yarn-error.log*
