# ──────────────────────────────────────────────
# CMS — Client Management System
# .gitignore
# ──────────────────────────────────────────────

# ── Secrets (NEVER commit these) ────────────────
.env

# ── Maven build output ──────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── IDE files ───────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
.vscode/
.classpath
.project
.settings/
*.eclipse

# ── OS files ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Environment & secrets ───────────────────────
.env
.env.*
!.env.example
*.secret

# ── Spring Boot ─────────────────────────────────
HELP.md
spring-shell.log

# ── Docker volumes (if mounted locally) ─────────
docker/volumes/

# ── Logs ────────────────────────────────────────
*.log
logs/

# ── Test reports ────────────────────────────────
**/surefire-reports/
**/failsafe-reports/

# ── SonarQube ───────────────────────────────────
.sonar/
sonar-project.properties

# ── Gradle (if switching later) ──────────────────
.gradle/
build/

# ── Node & Frontend ──────────────────────────────
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-error.log*
test-results/
playwright-report/
blob-report/
coverage/

# ── AI Agents, Prompts, & Workspace Artifacts ────
.agents/
.claude/
.gemini/
artifacts/
scratch/
implementation_plan.md
walkthrough.md
*.plan.md
*prompt.md
*.prompt
hs_err_pid*
replay_pid*

