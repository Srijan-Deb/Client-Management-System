# ==============================================================================
# CMS — Environment Variables Example Template
# ==============================================================================
# Copy this file to .env and configure with your local values.
# DO NOT commit .env into source control.
# ==============================================================================

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=cms_root_pass
MYSQL_PASSWORD=cms_pass
MYSQL_USERNAME=cms_user

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave empty for local development without authentication
REDIS_PASSWORD=

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_SECRET=cms-backend-secret-dev

# ── MinIO S3 Object Storage ───────────────────────────────────────────────────
MINIO_ROOT_USER=cms_minio
MINIO_ROOT_PASSWORD=cms_minio_secret
MINIO_ACCESS_KEY=cms_minio
MINIO_SECRET_KEY=cms_minio_secret

# ── Stripe (Test Mode) ────────────────────────────────────────────────────────
STRIPE_API_KEY=sk_test_placeholder

# ── ClickHouse Analytics ──────────────────────────────────────────────────────
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
